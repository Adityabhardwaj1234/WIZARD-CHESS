{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WizardChessModelArtifact",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "modelType",
    "architecture",
    "supportedEngineInterface",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 2, "maxLength": 80 },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "version": { "type": "string" },
    "modelType": { "type": "string", "enum": ["classical_24", "neural_mlp", "hybrid_ensemble"] },
    "architecture": { "type": "object" },
    "supportedEngineInterface": { "type": "string", "const": "cathedral-eval-v1" },
    "createdAt": { "type": "string" },
    "trained": { "type": "boolean" },
    "description": { "type": "string" },
    "evalParams": { "type": "object" },
    "weights": { "type": "object" },
    "trainingMetadata": { "type": "object" }
  }
}
